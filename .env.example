# Copy to .env.local for local dev, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Public site URL (used for SEO, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://reaperaudiotools.com

# Stripe. Use test keys (sk_test_…) first, live (sk_live_…) when you're ready.
# Developers → API keys → Create restricted key (rk_…) with only Checkout Sessions: Write
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Product catalog → each plugin's $29 price ID (price_…)
STRIPE_PRICE_DRUMCRUSHER=
STRIPE_PRICE_MODFX_PRO=
# Stripe as merchant of record (handles sales tax and VAT). Set to false to sell as yourself.
STRIPE_MANAGED_PAYMENTS=true

# Shown on the site and legal pages.
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_REFUND_DAYS=14

# Optional: forward waitlist signups as JSON to Zapier, Make, Loops, etc. Server-side only.
WAITLIST_WEBHOOK_URL=

# ---- Licensing (server-side only, never prefix with NEXT_PUBLIC_) ----
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# From `npm run license:keys`. Generate once and keep it. A new pair breaks existing activations.
LICENSE_SIGNING_PRIVATE_KEY=
# Computers per license
LICENSE_MAX_ACTIVATIONS=2
# Resend (resend.com) for license emails. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Reaper Audio Tools <licenses@yourdomain.com>

# Optional. Signs sign-in links and session cookies. Changing it signs everyone out.
AUTH_SECRET=
