# Copy to .env.local for local dev, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Public site URL (used for SEO, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://reaperaudiotools.com

# Paddle: start with sandbox, switch to production when Paddle approves the account
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle > Developer tools > Authentication > Client-side tokens (starts with test_ in sandbox, live_ in production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle > Catalog > Products > EasyDuck > Prices (starts with pri_)
NEXT_PUBLIC_PADDLE_PRICE_EASYDUCK=
# What the LCD price shows, e.g. $29
NEXT_PUBLIC_EASYDUCK_PRICE_LABEL=

# Shown on the site and legal pages. Seller name must match your Paddle account exactly.
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_REFUND_DAYS=14

# Optional: forward waitlist signups as JSON to Zapier, Make, Loops, etc. Server-side only.
WAITLIST_WEBHOOK_URL=
